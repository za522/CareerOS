# Local API
PORT=4310
HOST=127.0.0.1
CAREEROS_DATA_DIR=./data
# Optional global API request limit per minute. Production defaults to 1200.
CAREEROS_RATE_LIMIT_MAX=1200
# Local mode defaults to sqlite. Hosted/production mode requires postgres and fails closed otherwise.
CAREEROS_DATA_PROVIDER=sqlite

# AI and local single-user alerts (server only; never prefix these with VITE_)
OPENAI_API_KEY=
CAREEROS_AI_MODEL=gpt-5.6-terra
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private hosted workspace
CAREEROS_HOSTED=0
CAREEROS_APP_URL=http://127.0.0.1:5173
CAREEROS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CAREEROS_OWNER_EMAIL=
CAREEROS_SESSION_ENCRYPTION_KEY=
# Hosted Telegram tokens and chat IDs are encrypted per workspace with this server-only 32-byte key.
# Generate with: openssl rand -base64 32
CAREEROS_INTEGRATION_ENCRYPTION_KEY=
CAREEROS_INTEGRATION_ENCRYPTION_KEY_PREVIOUS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Required when CAREEROS_REALTIME_ENABLED=1; never expose as VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
CAREEROS_REALTIME_ENABLED=0
# Bounds server-to-server membership synchronisation so revocation cannot hang indefinitely.
CAREEROS_REALTIME_TIMEOUT_MS=8000
DATABASE_URL=
CAREEROS_MIGRATION_DATABASE_URL=
CAREEROS_SQLITE_MIGRATION_PATH=
CAREEROS_MIGRATION_WORKSPACE_ID=
CAREEROS_LOCAL_WORKSPACE_ID=local-workspace
CAREEROS_MIGRATION_WORKSPACE_NAME=CareerOS
# Required when a local identity such as local-development-user is referenced.
# Values must be the hosted user UUID and Google/Supabase subject UUID.
CAREEROS_MIGRATION_LOCAL_USER_ID=local-development-user
CAREEROS_MIGRATION_HOSTED_USER_ID=
CAREEROS_MIGRATION_HOSTED_GOOGLE_SUBJECT=
# For multiple users, use a JSON array instead of the three single-user variables above:
# CAREEROS_MIGRATION_USER_MAPPINGS=[{"localUserId":"local-development-user","hostedUserId":"...","hostedGoogleSubject":"..."}]
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=1
CAREEROS_STORAGE_PROVIDER=filesystem
CAREEROS_STORAGE_BUCKET=career-files
CAREEROS_BACKUP_STORAGE_PROVIDER=filesystem
CAREEROS_BACKUP_OBJECT_STORAGE_DIR=
CAREEROS_BACKUP_STORAGE_BUCKET=career-backups
# Optional local override. Defaults to a durable sibling directory named
# <CAREEROS_DATA_DIR basename>-object-storage, outside the replaceable data directory.
# Legacy CAREEROS_DATA_DIR/object-storage files are copied non-destructively on startup.
CAREEROS_OBJECT_STORAGE_DIR=
CAREEROS_BACKUP_ENCRYPTION_KEY=
CAREEROS_BACKUP_INTERVAL_HOURS=24

# Frontend build
VITE_API_URL=http://127.0.0.1:4310
