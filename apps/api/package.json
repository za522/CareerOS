{
  "name": "@careeros/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @careeros/contracts build && pnpm --filter @careeros/ai build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/postgres/migrations && cp src/postgres/migrations/*.sql dist/postgres/migrations/",
    "migrate:cloud": "pnpm build && node dist/cloud-migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @careeros/contracts build && pnpm --filter @careeros/ai build && vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@careeros/ai": "workspace:*",
    "@careeros/contracts": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "jose": "^6.2.8",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
